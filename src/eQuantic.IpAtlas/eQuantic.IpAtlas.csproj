<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>eQuantic.IpAtlas</PackageId>
    <Description>IP geolocation and network intelligence for .NET: a compact binary dataset format compiled from public RIR delegation data, fast in-memory range lookups (country, ASN), and travel-velocity math for impossible-travel risk signals. No external services, no license-encumbered databases.</Description>
    <PackageTags>ip;geoip;geolocation;asn;rir;security;risk;impossible-travel</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- Tracks the public surface in PublicAPI.*.txt, so a breaking change has to
         be written down before it will compile. Add new members to Unshipped.txt;
         on release, move its lines into Shipped.txt. Build-time only, so it never
         becomes a dependency of the package. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
