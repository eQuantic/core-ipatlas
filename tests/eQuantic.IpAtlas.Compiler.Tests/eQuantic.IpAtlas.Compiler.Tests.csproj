<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Test names read as sentences, and xunit facts cannot be static. -->
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1822;CA1861;CA5394</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\eQuantic.IpAtlas\eQuantic.IpAtlas.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.IpAtlas.Compiler\eQuantic.IpAtlas.Compiler.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\eQuantic.IpAtlas.Tests\Fixtures\**" Link="Fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
